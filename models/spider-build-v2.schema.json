{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spider Build v2",
  "description": "Independent construction, camera and narration tracks. Semantic validation is also required; see spider-build-v2.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "spider-build-tutorial"
    },
    "version": {
      "const": 2
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortTitle": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "const": "metres"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "units"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "timeUnit": {
          "const": "ms"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "timeUnit",
        "durationMs"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "meshes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mesh"
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/audioAsset"
          }
        }
      },
      "required": [
        "meshes",
        "audio"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        }
      },
      "required": [
        "palette",
        "objects"
      ],
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "tracks": {
      "type": "object",
      "properties": {
        "construction": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          },
          "required": [
            "steps"
          ],
          "additionalProperties": false
        },
        "camera": {
          "type": "object",
          "properties": {
            "initialPose": {
              "$ref": "#/$defs/pose"
            },
            "keyframes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyframe"
              }
            },
            "presets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/pose"
              }
            }
          },
          "required": [
            "initialPose",
            "keyframes",
            "presets"
          ],
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "cues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cue"
              }
            }
          },
          "required": [
            "cues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "construction",
        "camera",
        "narration"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "cutaway": {
          "type": "object",
          "properties": {
            "excludePrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cameraPreset": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "excludePrefixes",
            "cameraPreset"
          ],
          "additionalProperties": false
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "metadata",
    "timeline",
    "assets",
    "scene",
    "chapters",
    "tracks"
  ],
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "properties": {
        "eye": {
          "$ref": "#/$defs/vec3"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "eye",
        "yaw",
        "pitch"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "v": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "mat": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "v"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "positions",
        "faces"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meshRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "meshRef"
      ],
      "additionalProperties": false
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "put"
            },
            "object": {
              "$ref": "#/$defs/object"
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "remove"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        },
        "command": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "additionalProperties": false
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "executedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "timeMs",
        "command",
        "changes"
      ],
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "transition": {
          "enum": [
            "cut",
            "linear",
            "smoothstep"
          ]
        }
      },
      "required": [
        "id",
        "timeMs",
        "pose",
        "transition"
      ],
      "additionalProperties": false
    },
    "audioAsset": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "mimeType"
      ],
      "additionalProperties": false
    },
    "audioCue": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "offsetMs": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        },
        "channel": {
          "enum": [
            "chapter",
            "operation",
            "voiceover"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "$ref": "#/$defs/audioCue"
        }
      },
      "required": [
        "id",
        "startMs",
        "endMs",
        "channel",
        "language"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "audio"
          ]
        }
      ]
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cameraPreset": {
          "type": "string",
          "minLength": 1
        },
        "availableFromMs": {
          "type": "number",
          "minimum": 0
        },
        "includePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "cameraPreset",
        "availableFromMs",
        "includePrefixes",
        "excludePrefixes"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "metal": {
          "type": "number"
        },
        "rough": {
          "type": "number"
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emit": {
          "type": "number"
        },
        "soft": {
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    }
  }
}
