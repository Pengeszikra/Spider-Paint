{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spider Build v2",
  "description": "Independent construction, camera and narration tracks. Semantic validation is also required; see spider-build-v2.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "spider-build-tutorial"
    },
    "version": {
      "const": 2
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "shortTitle": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "const": "metres"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "units"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "timeUnit": {
          "const": "ms"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "timeUnit",
        "durationMs"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "meshes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/mesh"
          }
        },
        "audio": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/audioAsset"
          }
        }
      },
      "required": [
        "meshes",
        "audio"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/material"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "environment": {
          "$ref": "#/$defs/environment"
        }
      },
      "required": [
        "palette",
        "objects"
      ],
      "additionalProperties": false
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    },
    "tracks": {
      "type": "object",
      "properties": {
        "construction": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          },
          "required": [
            "steps"
          ],
          "additionalProperties": false
        },
        "camera": {
          "type": "object",
          "properties": {
            "initialPose": {
              "$ref": "#/$defs/pose"
            },
            "keyframes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/keyframe"
              }
            },
            "presets": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/pose"
              }
            }
          },
          "required": [
            "initialPose",
            "keyframes",
            "presets"
          ],
          "additionalProperties": false
        },
        "narration": {
          "type": "object",
          "properties": {
            "cues": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cue"
              }
            }
          },
          "required": [
            "cues"
          ],
          "additionalProperties": false
        },
        "animation": {
          "$ref": "#/$defs/animation"
        }
      },
      "required": [
        "construction",
        "camera",
        "narration"
      ],
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "properties": {
        "cutaway": {
          "type": "object",
          "properties": {
            "excludePrefixes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "cameraPreset": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "excludePrefixes",
            "cameraPreset"
          ],
          "additionalProperties": false
        },
        "views": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/view"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "result": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "version",
    "metadata",
    "timeline",
    "assets",
    "scene",
    "chapters",
    "tracks"
  ],
  "additionalProperties": false,
  "$defs": {
    "vec3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "pose": {
      "type": "object",
      "properties": {
        "eye": {
          "$ref": "#/$defs/vec3"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "roll": {
          "type": "number"
        },
        "fov": {
          "type": "number",
          "minimum": 5,
          "maximum": 150
        }
      },
      "required": [
        "eye",
        "yaw",
        "pitch"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vec3"
          }
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "v": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "color": {
                "type": "string",
                "minLength": 1
              },
              "mat": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "v"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "positions",
        "faces"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "meshRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "meshRef"
      ],
      "additionalProperties": false
    },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "put"
            },
            "object": {
              "$ref": "#/$defs/object"
            }
          },
          "required": [
            "type",
            "object"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "remove"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "name"
          ],
          "additionalProperties": false
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        },
        "command": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "args": {
              "type": "object"
            }
          },
          "required": [
            "tool",
            "args"
          ],
          "additionalProperties": false
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "executedAt": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "timeMs",
        "command",
        "changes"
      ],
      "additionalProperties": false
    },
    "keyframe": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timeMs": {
          "type": "number",
          "minimum": 0
        },
        "pose": {
          "$ref": "#/$defs/pose"
        },
        "transition": {
          "enum": [
            "cut",
            "linear",
            "smoothstep"
          ]
        }
      },
      "required": [
        "id",
        "timeMs",
        "pose",
        "transition"
      ],
      "additionalProperties": false
    },
    "audioAsset": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "uri",
        "mimeType"
      ],
      "additionalProperties": false
    },
    "audioCue": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "offsetMs": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "assetId"
      ],
      "additionalProperties": false
    },
    "cue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        },
        "channel": {
          "enum": [
            "chapter",
            "operation",
            "voiceover"
          ]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "$ref": "#/$defs/audioCue"
        }
      },
      "required": [
        "id",
        "startMs",
        "endMs",
        "channel",
        "language"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "text"
          ]
        },
        {
          "required": [
            "audio"
          ]
        }
      ]
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "startMs": {
          "type": "number",
          "minimum": 0
        },
        "endMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "title",
        "startMs",
        "endMs"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "cameraPreset": {
          "type": "string",
          "minLength": 1
        },
        "availableFromMs": {
          "type": "number",
          "minimum": 0
        },
        "includePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excludePrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "cameraPreset",
        "availableFromMs",
        "includePrefixes",
        "excludePrefixes"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "metal": {
          "type": "number"
        },
        "rough": {
          "type": "number"
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "emit": {
          "type": "number"
        },
        "soft": {
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "cloud": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "p": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "r": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "c": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          }
        },
        "l": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "unit",
        "n",
        "p",
        "r",
        "c",
        "l"
      ],
      "additionalProperties": false
    },
    "environmentInstance": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "proto": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "$ref": "#/$defs/vec3"
        },
        "scale": {
          "oneOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          ]
        },
        "mats": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "glow": {
          "type": "number"
        },
        "glowColor": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "minLength": 1
        },
        "far": {
          "type": "boolean"
        },
        "rot": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "pickable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "proto",
        "at",
        "scale"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "format": {
          "const": "3draft-scene"
        },
        "version": {
          "enum": [
            1,
            2
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prototypes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "lods": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/mesh"
                }
              },
              "halo": {
                "type": "boolean"
              }
            },
            "required": [
              "lods"
            ],
            "additionalProperties": false
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/environmentInstance"
              },
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mesh": {
                    "$ref": "#/$defs/mesh"
                  }
                },
                "required": [
                  "name",
                  "mesh"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "cloud": {
          "$ref": "#/$defs/cloud"
        },
        "vehicle": {
          "enum": [
            "none",
            "starship",
            "car",
            null
          ]
        },
        "view": {
          "type": "object"
        }
      },
      "required": [
        "format",
        "version",
        "objects"
      ],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "timesMs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "channels": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "matrices": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 12,
                  "maxItems": 12,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "emission": {
                "description": "Optional per-channel emission multipliers, linearly sampled on timesMs; omitted means 1.",
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "required": [
              "id",
              "matrices"
            ],
            "additionalProperties": false
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "string",
                    "minLength": 1
                  },
                  "channel": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "object",
                  "channel"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "object": {
                    "type": "string",
                    "minLength": 1
                  },
                  "weights": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 4,
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "number",
                            "minimum": 0
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2
                      }
                    }
                  }
                },
                "required": [
                  "object",
                  "weights"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "timesMs",
        "channels",
        "bindings"
      ],
      "additionalProperties": false
    }
  }
}
