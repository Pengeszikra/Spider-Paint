{
  "name": "spider-paint",
  "version": "26.11.25004",
  "description": "Spider Paint: the test and community workshop of the 3Draft engine (custom MCP test program)",
  "brand": {
    "repo": "Pengeszikra/spider-paint",
    "branch": "master",
    "site": "https://spider-paint.vercel.app",
    "mcp": "https://spider-paint.vercel.app/api/mcp",
    "own": [
      "models/",
      "paint-docs/",
      ".github/",
      "media/spider-paint-2015.png",
      "vercel.json",
      "scripts/lark-4/",
      "scripts/lark-4c-accident/",
      "scripts/models/",
      "scripts/build-wyoming-massing.mjs",
      "scripts/spider-build.mjs",
      "scripts/spider-build.test.mjs",
      "scripts/spider-build.browser-test.py",
      "scripts/build-modular-characters.mjs",
      "scripts/modular-characters.test.mjs"
    ],
    "share": [
      "models/spider-build-v2.mjs",
      "models/spider-build-v2.md",
      "models/spider-build-v2.schema.json",
      "models/modular-characters/compose.mjs",
      "models/modular-characters/library.json"
    ]
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "spider-paint": "./bin/spider-paint.mjs",
    "spider-paint-workshop-mcp": "./bin/workshop-mcp.mjs",
    "spider-paint-term": "./bin/spider-term.mjs"
  },
  "scripts": {
    "start": "node bin/spider-paint.mjs",
    "term": "node bin/spider-term.mjs",
    "test": "node tests/math.mjs && node tests/smoke.mjs && node tests/instance.mjs && node tests/materials.mjs && node tests/svg-export.mjs && node tests/state.mjs && node tests/term.mjs",
    "test:all": "node scripts/test-all.mjs",
    "bump": "node scripts/bump.mjs",
    "workshop": "node bin/workshop.mjs",
    "test:workshop": "node tests/workshop.mjs",
    "mcp:workshop": "node bin/workshop-mcp.mjs",
    "test:mcp-app": "node tests/mcp-app.mjs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs",
    "transfer": "node scripts/transfer.mjs",
    "brand": "node scripts/transfer.mjs --brand"
  },
  "files": [
    "api/",
    "mcp/",
    "bin/",
    "engine/",
    "icons/",
    "media/",
    "models/",
    "src/",
    "index.html",
    "player.html",
    "emulator.html",
    "sky.html",
    "xr-test.html",
    "xr-compare.html",
    "sky.md",
    "help.md",
    "PLAYER.md",
    "APP.md",
    "MCP.md",
    "favicon.svg",
    "manifest.webmanifest",
    "sw.js",
    "Dockerfile",
    "nginx.conf",
    "README.md",
    "workshop.html",
    "LICENSE",
    "TRANSFER.md"
  ],
  "dependencies": {
    "@vercel/blob": "^2.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
